{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMtrix",
  "version": "0.1.0",
  "identifier": "bike.tyrel.aimtrix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "signon",
        "url": "/signon",
        "title": "Sign On",
        "width": 250,
        "height": 300,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
